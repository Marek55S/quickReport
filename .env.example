# Copy to .env.local for local development. On Cloud Run set these as service env vars.
# Authentication uses Application Default Credentials:
#   locally: gcloud auth application-default login
#   Cloud Run: the service's attached service account

GOOGLE_CLOUD_PROJECT=your-project-id
# Region for Vertex AI (Gemini)
GOOGLE_CLOUD_LOCATION=europe-west1
# Cloud Storage bucket for report photos
GCS_BUCKET=your-project-id-report-images
# Gemini model id available in your project/region
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 to return a deterministic mock AI response (no Vertex AI calls)
AI_MOCK=1
# Shared password for the official dashboard (/admin); the dashboard stays locked when unset
ADMIN_PASSWORD=change-me
# Secret for signing dashboard session cookies (optional; falls back to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Letter delivery (prototype): e-mail with the PDF to a test inbox through any SMTP server.
# Without SMTP_URL the delivery is simulated (PDF is still generated and stored).
# Example: smtps://user%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM=
DELIVERY_TEST_EMAIL=
